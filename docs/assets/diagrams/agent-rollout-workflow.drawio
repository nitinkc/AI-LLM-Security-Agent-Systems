<mxfile host="Electron">
  <diagram id="rollout-workflow" name="Scenario Drill Flow">
    <mxGraphModel dx="1080" dy="460" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="360" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="frame" value="Operational Scenario Runbook Flow (Constrained Execution to Verified Closure)" style="swimlane;startSize=32;rounded=1;arcSize=4;html=1;fillColor=light-dark(#e2e8f0,#2d3748);swimlaneFillColor=light-dark(#ffffff,#181c26);strokeColor=light-dark(#475569,#94a3b8);strokeWidth=2;fontColor=light-dark(#0f172a,#f8fafc);fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1020" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1 · Select Workflows&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Prioritize high-value target set &amp;amp; risk tier&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=light-dark(#dbeafe,#1d4ed8);strokeColor=light-dark(#1d4ed8,#93c5fd);strokeWidth=2;fontColor=light-dark(#0f172a,#ffffff);fontSize=12;" vertex="1" parent="frame">
          <mxGeometry x="24" y="62" width="170" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2 · Constrained Run&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Execute within policy &amp;amp; stop conditions&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=light-dark(#dbeafe,#1d4ed8);strokeColor=light-dark(#1d4ed8,#93c5fd);strokeWidth=2;fontColor=light-dark(#0f172a,#ffffff);fontSize=12;" vertex="1" parent="frame">
          <mxGeometry x="228" y="62" width="170" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3 · Quality Gate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Evidence valid?&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=light-dark(#fef3c7,#b45309);strokeColor=light-dark(#b45309,#fcd34d);strokeWidth=2;fontColor=light-dark(#451a03,#ffffff);fontSize=12;" vertex="1" parent="frame">
          <mxGeometry x="434" y="48" width="160" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4 · Owner Handoff&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Package repro steps, impact &amp;amp; recommendation&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=light-dark(#dcfce7,#047857);strokeColor=light-dark(#15803d,#6ee7b7);strokeWidth=2;fontColor=light-dark(#052e16,#ffffff);fontSize=12;" vertex="1" parent="frame">
          <mxGeometry x="640" y="62" width="170" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5 · Verify &amp;amp; Close&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Re-test deployed fix &amp;amp; update eval suite&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=light-dark(#f3e8ff,#6d28d9);strokeColor=light-dark(#7e22ce,#d8b4fe);strokeWidth=2;fontColor=light-dark(#2e1065,#ffffff);fontSize=12;" vertex="1" parent="frame">
          <mxGeometry x="836" y="62" width="164" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="fb" value="&lt;b&gt;HITL Escalation / Fallback&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Suppress noisy output, tighten hypothesis &amp;amp; retry safely&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=light-dark(#fee2e2,#be123c);strokeColor=light-dark(#b91c1c,#fda4af);strokeWidth=2;fontColor=light-dark(#450a0a,#ffffff);fontSize=12;" vertex="1" parent="frame">
          <mxGeometry x="389" y="210" width="250" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=light-dark(#334155,#cbd5e1);strokeWidth=2;endArrow=block;" edge="1" parent="frame" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=light-dark(#334155,#cbd5e1);strokeWidth=2;endArrow=block;" edge="1" parent="frame" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="Pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=light-dark(#15803d,#6ee7b7);strokeWidth=2;endArrow=block;fontColor=light-dark(#052e16,#ecfdf5);labelBackgroundColor=light-dark(#dcfce7,#064e3b);fontSize=11;" edge="1" parent="frame" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=light-dark(#334155,#cbd5e1);strokeWidth=2;endArrow=block;" edge="1" parent="frame" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="Low confidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=light-dark(#b91c1c,#fda4af);strokeWidth=2;endArrow=block;fontColor=light-dark(#450a0a,#fef2f2);labelBackgroundColor=light-dark(#fee2e2,#7f1d1d);fontSize=11;" edge="1" parent="frame" source="s3" target="fb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Refined scope" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=light-dark(#b91c1c,#fda4af);strokeWidth=2;endArrow=block;fontColor=light-dark(#450a0a,#fef2f2);labelBackgroundColor=light-dark(#fee2e2,#7f1d1d);fontSize=11;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="frame" source="fb" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
