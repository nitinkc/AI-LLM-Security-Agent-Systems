<mxfile host="Electron">
  <diagram id="key-principles" name="Principle Stack">
    <mxGraphModel dx="900" dy="620" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="560" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="frame" value="Defense-in-Depth Principle Stack (Foundation to Continuous Assurance)" style="swimlane;startSize=34;rounded=1;arcSize=4;html=1;fillColor=light-dark(#e2e8f0,#2d3748);swimlaneFillColor=light-dark(#ffffff,#181c26);strokeColor=light-dark(#475569,#94a3b8);strokeWidth=2;fontColor=light-dark(#0f172a,#f8fafc);fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="800" height="474" as="geometry"/>
        </mxCell>
        <mxCell id="l5" value="&lt;b style=&quot;font-size:14px&quot;&gt;5 · Continuously Evaluated&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Outcome-tied eval suites &amp;amp; regression gates prevent silent capability or safety drift&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=light-dark(#f3e8ff,#5b21b6);strokeColor=light-dark(#7e22ce,#d8b4fe);strokeWidth=2;fontColor=light-dark(#1e1b4b,#ffffff);" vertex="1" parent="frame">
          <mxGeometry x="40" y="54" width="720" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="l4" value="&lt;b style=&quot;font-size:14px&quot;&gt;4 · Observable and Recoverable&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;End-to-end traces, action logs, checkpoints, circuit breakers &amp;amp; fast rollback&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=light-dark(#fef3c7,#b45309);strokeColor=light-dark(#b45309,#fcd34d);strokeWidth=2;fontColor=light-dark(#451a03,#ffffff);" vertex="1" parent="frame">
          <mxGeometry x="40" y="136" width="720" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="l3" value="&lt;b style=&quot;font-size:14px&quot;&gt;3 · Human Steering at Risk Boundaries&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;HITL approval queues gate high-blast-radius actions &amp;amp; low-confidence reasoning&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=light-dark(#fee2e2,#be123c);strokeColor=light-dark(#b91c1c,#fda4af);strokeWidth=2;fontColor=light-dark(#450a0a,#ffffff);" vertex="1" parent="frame">
          <mxGeometry x="40" y="218" width="720" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="l2" value="&lt;b style=&quot;font-size:14px&quot;&gt;2 · Safe by Default&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Deny-by-default policy engine, scoped tool contracts &amp;amp; least-privilege credentials&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=light-dark(#dbeafe,#1d4ed8);strokeColor=light-dark(#1d4ed8,#93c5fd);strokeWidth=2;fontColor=light-dark(#0f172a,#ffffff);" vertex="1" parent="frame">
          <mxGeometry x="40" y="300" width="720" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="l1" value="&lt;b style=&quot;font-size:14px&quot;&gt;1 · Impact First (Foundation)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Rank workflows by measurable user value, security risk reduction &amp;amp; business priority&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=light-dark(#dcfce7,#047857);strokeColor=light-dark(#15803d,#6ee7b7);strokeWidth=2;fontColor=light-dark(#052e16,#ffffff);" vertex="1" parent="frame">
          <mxGeometry x="40" y="382" width="720" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=light-dark(#334155,#cbd5e1);strokeWidth=2;endArrow=block;" edge="1" parent="frame" source="l1" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=light-dark(#334155,#cbd5e1);strokeWidth=2;endArrow=block;" edge="1" parent="frame" source="l2" target="l3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=light-dark(#334155,#cbd5e1);strokeWidth=2;endArrow=block;" edge="1" parent="frame" source="l3" target="l4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=light-dark(#334155,#cbd5e1);strokeWidth=2;endArrow=block;" edge="1" parent="frame" source="l4" target="l5"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
