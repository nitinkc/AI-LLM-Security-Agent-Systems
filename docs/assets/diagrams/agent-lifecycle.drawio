<mxfile host="Electron">
  <diagram id="agent-lifecycle" name="End-to-End LLM Agent Loop">
    <mxGraphModel dx="1000" dy="520" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="400" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="g1" value="1 · Framing (Authorized Scope)" style="swimlane;startSize=32;rounded=1;arcSize=5;html=1;fillColor=light-dark(#dbeafe,#1e3a8a);swimlaneFillColor=light-dark(#f8fafc,#181c26);strokeColor=light-dark(#1d4ed8,#60a5fa);strokeWidth=2;fontColor=light-dark(#0f172a,#eff6ff);fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="280" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;Define Intent &amp;amp; Boundaries&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Specify user goal, allowed actions &amp;amp; stop rules&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=light-dark(#dbeafe,#1d4ed8);strokeColor=light-dark(#1d4ed8,#93c5fd);strokeWidth=2;fontColor=light-dark(#0f172a,#ffffff);fontSize=12;" vertex="1" parent="g1">
          <mxGeometry x="20" y="52" width="240" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;Select Context &amp;amp; Constraints&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Isolate untrusted retrieved text from instructions&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=light-dark(#dbeafe,#1d4ed8);strokeColor=light-dark(#1d4ed8,#93c5fd);strokeWidth=2;fontColor=light-dark(#0f172a,#ffffff);fontSize=12;" vertex="1" parent="g1">
          <mxGeometry x="20" y="164" width="240" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="g2" value="2 · Execution (Guarded Runtime)" style="swimlane;startSize=32;rounded=1;arcSize=5;html=1;fillColor=light-dark(#fef3c7,#78350f);swimlaneFillColor=light-dark(#f8fafc,#181c26);strokeColor=light-dark(#b45309,#fbbf24);strokeWidth=2;fontColor=light-dark(#451a03,#fffbeb);fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="20" width="280" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="v1" value="&lt;b&gt;Plan Steps &amp;amp; Choose Tools&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Validate typed schemas &amp;amp; risk tier before call&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=light-dark(#fef3c7,#b45309);strokeColor=light-dark(#b45309,#fcd34d);strokeWidth=2;fontColor=light-dark(#451a03,#ffffff);fontSize=12;" vertex="1" parent="g2">
          <mxGeometry x="20" y="52" width="240" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="v2" value="&lt;b&gt;Execute Calls &amp;amp; Synthesize&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Run sandboxed tools &amp;amp; package grounded evidence&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=light-dark(#fef3c7,#b45309);strokeColor=light-dark(#b45309,#fcd34d);strokeWidth=2;fontColor=light-dark(#451a03,#ffffff);fontSize=12;" vertex="1" parent="g2">
          <mxGeometry x="20" y="164" width="240" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="g3" value="3 · Improvement (Closed Loop)" style="swimlane;startSize=32;rounded=1;arcSize=5;html=1;fillColor=light-dark(#dcfce7,#064e3b);swimlaneFillColor=light-dark(#f8fafc,#181c26);strokeColor=light-dark(#15803d,#34d399);strokeWidth=2;fontColor=light-dark(#052e16,#ecfdf5);fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="20" width="280" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;Evaluate Result Quality&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Score utility, faithfulness &amp;amp; policy compliance&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=light-dark(#dcfce7,#047857);strokeColor=light-dark(#15803d,#6ee7b7);strokeWidth=2;fontColor=light-dark(#052e16,#ffffff);fontSize=12;" vertex="1" parent="g3">
          <mxGeometry x="20" y="52" width="240" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;Iterate Prompts, Tools &amp;amp; Policy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Promote regression cases into release gates&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=light-dark(#f3e8ff,#6d28d9);strokeColor=light-dark(#7e22ce,#d8b4fe);strokeWidth=2;fontColor=light-dark(#2e1065,#ffffff);fontSize=12;" vertex="1" parent="g3">
          <mxGeometry x="20" y="164" width="240" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=light-dark(#334155,#cbd5e1);strokeWidth=2;endArrow=block;" edge="1" parent="g1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=light-dark(#334155,#cbd5e1);strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2" target="v1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=light-dark(#334155,#cbd5e1);strokeWidth=2;endArrow=block;" edge="1" parent="g2" source="v1" target="v2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=light-dark(#334155,#cbd5e1);strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v2" target="r1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=light-dark(#334155,#cbd5e1);strokeWidth=2;endArrow=block;" edge="1" parent="g3" source="r1" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Continuous Feedback Loop (Eval Signals Tighten Boundaries &amp;amp; Contracts)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=light-dark(#7e22ce,#d8b4fe);strokeWidth=2;endArrow=block;fontColor=light-dark(#2e1065,#faf5ff);labelBackgroundColor=light-dark(#f3e8ff,#4c1d95);fontSize=11;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="r2" target="d1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
