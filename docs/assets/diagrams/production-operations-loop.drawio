<mxfile host="Electron">
  <diagram id="prod-ops-loop" name="Reliability Control Loop">
    <mxGraphModel dx="920" dy="480" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="380" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="frame" value="Production Reliability &amp; Incident Control Loop" style="swimlane;startSize=32;rounded=1;arcSize=4;html=1;fillColor=light-dark(#e2e8f0,#2d3748);swimlaneFillColor=light-dark(#ffffff,#181c26);strokeColor=light-dark(#475569,#94a3b8);strokeWidth=2;fontColor=light-dark(#0f172a,#f8fafc);fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="840" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="m" value="&lt;b&gt;1 · Monitor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Traces, logs, SLOs &amp;amp; policy telemetry&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=light-dark(#dbeafe,#1d4ed8);strokeColor=light-dark(#1d4ed8,#93c5fd);strokeWidth=2;fontColor=light-dark(#0f172a,#ffffff);fontSize=12;" vertex="1" parent="frame">
          <mxGeometry x="40" y="60" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="d" value="&lt;b&gt;2 · Detect Degradation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Catch model drift, tool errors &amp;amp; latency spikes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=light-dark(#fef3c7,#b45309);strokeColor=light-dark(#b45309,#fcd34d);strokeWidth=2;fontColor=light-dark(#451a03,#ffffff);fontSize=12;" vertex="1" parent="frame">
          <mxGeometry x="310" y="60" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="t" value="&lt;b&gt;3 · Triaged Response&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Assign owner, bound blast radius &amp;amp; gate risk&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=light-dark(#fee2e2,#be123c);strokeColor=light-dark(#b91c1c,#fda4af);strokeWidth=2;fontColor=light-dark(#450a0a,#ffffff);fontSize=12;" vertex="1" parent="frame">
          <mxGeometry x="580" y="60" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="r" value="&lt;b&gt;4 · Recover Safely&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Circuit break, rollback model/prompt or fallback&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=light-dark(#f3e8ff,#6d28d9);strokeColor=light-dark(#7e22ce,#d8b4fe);strokeWidth=2;fontColor=light-dark(#2e1065,#ffffff);fontSize=12;" vertex="1" parent="frame">
          <mxGeometry x="460" y="200" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="v" value="&lt;b&gt;5 · Validate Behavior&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Run incident evals &amp;amp; verify canary health&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=light-dark(#dcfce7,#047857);strokeColor=light-dark(#15803d,#6ee7b7);strokeWidth=2;fontColor=light-dark(#052e16,#ffffff);fontSize=12;" vertex="1" parent="frame">
          <mxGeometry x="150" y="200" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=light-dark(#334155,#cbd5e1);strokeWidth=2;endArrow=block;" edge="1" parent="frame" source="m" target="d"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=light-dark(#334155,#cbd5e1);strokeWidth=2;endArrow=block;" edge="1" parent="frame" source="d" target="t"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=light-dark(#334155,#cbd5e1);strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="frame" source="t" target="r"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=light-dark(#334155,#cbd5e1);strokeWidth=2;endArrow=block;" edge="1" parent="frame" source="r" target="v"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="Resume steady state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=light-dark(#15803d,#6ee7b7);strokeWidth=2;endArrow=block;fontColor=light-dark(#052e16,#ecfdf5);labelBackgroundColor=light-dark(#dcfce7,#064e3b);fontSize=11;exitX=0;exitY=0.5;entryX=0.25;entryY=1;" edge="1" parent="frame" source="v" target="m"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
